<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
    <interface>
        <field id="exitApp" type="boolean" value="false" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
    <script type="text/brightscript" uri="pkg:/components/MainScene_Menu.brs" />
    <script type="text/brightscript" uri="pkg:/components/MainScene_Keys.brs" />
    <children>
        <!-- Full-screen slideshow: black bg + poster + auto-advance timer -->
        <SlideshowComponent id="slideshow" />

        <!-- Top-left "current / total" counter -->
        <HUDComponent id="hud" />

        <!-- Photo info overlay (bottom, toggled by Down/Up) -->
        <PhotoInfoComponent id="photoInfo" translation="[0, 620]" visible="false" />

        <!-- Play/Pause icon (centre of screen, visible for 2s on toggle) -->
        <Poster
            id="pauseIcon"
            width="200"
            height="200"
            translation="[540, 260]"
            loadDisplayMode="scaleToFit"
            visible="false"
        />
        <Timer id="pauseIconTimer" duration="2.0" repeat="false" />

        <!-- End of slideshow screen (centred, shown when playlist ends with looping off) -->
        <EndScreenComponent id="endScreen" visible="false" />

        <!-- Menu overlay (centred, shown on demand) -->
        <MenuComponent id="menuComponent" visible="false" />

        <!-- Auto-close timer: closes menu 2s after a boolean selection -->
        <Timer id="autoCloseTimer" duration="2.0" repeat="false" />

        <!-- Error message (hidden by default) -->
        <Label
            id="errorLabel"
            text=""
            color="0xff4444ff"
            font="font:SmallSystemFont"
            translation="[20, 660]"
            visible="false"
        />
    </children>
</component>
