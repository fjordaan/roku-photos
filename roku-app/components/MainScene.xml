<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
    <children>
        <!-- Full-screen slideshow: black bg + poster + auto-advance timer -->
        <SlideshowComponent id="slideshow" />

        <!-- Top-left "current / total" counter -->
        <HUDComponent id="hud" />

        <!-- Current photo path (bottom-left) -->
        <Rectangle
            color="0x00000099"
            width="1280"
            height="28"
            translation="[0, 688]"
        />
        <Label
            id="photoPath"
            text=""
            color="0xffffffff"
            font="font:SmallSystemFont"
            translation="[12, 692]"
        />

        <!-- Play/Pause icon (centre of screen, visible for 2s on toggle) -->
        <Group id="pauseOverlay" translation="[490, 285]" visible="false">
            <Rectangle color="0x00000099" width="300" height="150" />
            <Label
                id="pauseIcon"
                text=""
                color="0xffffffff"
                font="font:LargeSystemFont"
                horizAlign="center"
                width="300"
                translation="[0, 55]"
            />
        </Group>
        <Timer id="pauseIconTimer" duration="2.0" repeat="false" />

        <!-- Error message (hidden by default) -->
        <Label
            id="errorLabel"
            text=""
            color="0xff4444ff"
            font="font:SmallSystemFont"
            translation="[20, 660]"
            visible="false"
        />
    </children>
</component>
