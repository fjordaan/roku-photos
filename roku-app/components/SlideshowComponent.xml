<?xml version="1.0" encoding="utf-8" ?>
<component name="SlideshowComponent" extends="Group">
    <interface>
        <!-- Set to trigger photo display update -->
        <field id="photoUrl"      type="string"  value=""    onChange="onPhotoUrlChange" />
        <!-- Set by MainScene while current photo is showing, to preload the next one -->
        <field id="preloadUrl"    type="string"  value=""    onChange="onPreloadUrlChange" />
        <!-- true = paused, false = running -->
        <field id="paused"        type="boolean" value="true"  onChange="onPausedChange" />
        <!-- Slide duration in seconds -->
        <field id="slideDuration" type="float"   value="5.0" onChange="onSlideDurationChange" />
        <!-- true = dissolve transition, false = instant cut (visual effect TODO) -->
        <field id="dissolve"      type="boolean" value="true" />
        <!-- Fires on each timer tick; alwaysNotify so observers fire even if value stays true -->
        <field id="advance"       type="boolean" value="false" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/SlideshowComponent.brs" />
    <children>
        <!-- Black background shown while photo loads -->
        <Rectangle
            id="bg"
            color="0x000000ff"
            width="1280"
            height="720"
        />

        <!-- Double-buffered posters: one visible (current), one hidden (preloading next) -->
        <Poster id="posterA" width="1280" height="720" loadDisplayMode="scaleToFit" visible="true" />
        <Poster id="posterB" width="1280" height="720" loadDisplayMode="scaleToFit" visible="false" />

        <!-- Auto-advance timer -->
        <Timer
            id="timer"
            repeat="true"
            duration="5.0"
        />

        <!-- Dissolve transition: fade out the current poster while the next shows through -->
        <Animation id="animA" duration="0.5" easeFunction="linear" repeat="false">
            <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[1.0, 0.0]" fieldToInterp="posterA.opacity" />
        </Animation>
        <Animation id="animB" duration="0.5" easeFunction="linear" repeat="false">
            <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[1.0, 0.0]" fieldToInterp="posterB.opacity" />
        </Animation>
        <!-- Fires when dissolve is complete so we can clean up poster state -->
        <Timer id="dissolveTimer" duration="0.5" repeat="false" />
    </children>
</component>
